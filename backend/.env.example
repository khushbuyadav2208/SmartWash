MONGODB_URI=mongodb://127.0.0.1:27017/smart_wash?replicaSet=rs0
PORT=5000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
LAUNDRY_TIMEZONE=Asia/Kolkata
SESSION_HOURS=12
# Optional SMTP enables password-reset and verification email. Never commit secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Bootstrap is explicit: npm run bootstrap (does not reset existing users)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# Optional explicit demo bootstrap. Keep false for ordinary and production operation.
DEMO_DATA_ENABLED=false
DEMO_PASSWORD=
